<Window x:Class="PanGuardian.App.Views.MigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迁移向导"
        Width="1180"
        Height="820"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="微信 / 企业微信迁移向导" />
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="MVP 已形成闭环：先安全复制，再切换目录联接；如果要恢复，就点击回滚原目录。" />
                    <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding SummaryText}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="候选目录" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="推荐顺序：复制 -> 切换联接 -> 验证使用。如果要恢复，就执行回滚。" />

                    <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <Border Margin="10,0,0,0" Padding="10,4" Background="#FFF0DD" CornerRadius="12">
                                                    <TextBlock Text="{Binding StatusText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AppName}" />
                                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding SourcePath}" />
                                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SuggestedTargetPath}" />
                                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Reason}" />
                                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Text="{Binding OperationHint}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SizeText}" />
                                            <Button Margin="0,14,0,0" MinWidth="120" Content="执行复制" Click="ExecuteMigration" IsEnabled="{Binding CanExecuteCopy}" ToolTip="{Binding OperationHint}" />
                                            <Button Margin="0,10,0,0" MinWidth="120" Style="{StaticResource SecondaryButtonStyle}" Content="切换联接" Click="SwitchMigration" IsEnabled="{Binding CanSwitch}" ToolTip="{Binding OperationHint}" />
                                            <Button Margin="0,10,0,0" MinWidth="120" Style="{StaticResource DangerButtonStyle}" Content="回滚原目录" Click="RollbackMigration" IsEnabled="{Binding CanRollback}" ToolTip="{Binding OperationHint}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
