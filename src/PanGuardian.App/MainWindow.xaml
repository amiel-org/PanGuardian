<Window x:Class="PanGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PanGuardian.App.Controls"
        mc:Ignorable="d"
        Title="豆豆蛙磁盘管家"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowsTransparency="False">
    <Grid Background="{StaticResource BgBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="14" />
                <RowDefinition Height="370" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="28" Height="28">
                        <Border CornerRadius="8" Background="#E7F2FF" BorderBrush="#CFE5FF" BorderThickness="1" />
                        <UniformGrid Columns="2" Rows="2" Margin="7">
                            <Rectangle Margin="1" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}" />
                            <Rectangle Margin="1" RadiusX="2" RadiusY="2" Fill="#4DB3FF" />
                            <Rectangle Margin="1" RadiusX="2" RadiusY="2" Fill="#54D6D6" />
                            <Rectangle Margin="1" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentAltBrush}" />
                        </UniformGrid>
                    </Grid>
                    <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="豆豆蛙磁盘管家" />
                    <TextBlock Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}" Text="磁盘驾驶舱 · 清理 · 迁移" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="42" Height="28" Padding="0" Style="{StaticResource GhostButtonStyle}" Content="—" Click="MinimizeWindow" />
                    <Button Width="42" Height="28" Padding="0" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Content="□" Click="ToggleMaximizeWindow" />
                    <Button Width="42" Height="28" Padding="0" Margin="6,0,0,0" Style="{StaticResource DangerButtonStyle}" Content="×" Click="CloseWindow" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource HairlineStyle}" />

            <Border Grid.Row="2" Style="{StaticResource ElevatedPanelStyle}" Padding="0" ClipToBounds="True" Background="#10263B" BorderBrush="#6D9CC4">
                <Grid>
                    <Image Source="Assets/open-design-disk-cockpit-v2-hero-wide.png"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Opacity="1" />

                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F20A1D2F" Offset="0" />
                                <GradientStop Color="#D30D2438" Offset="0.34" />
                                <GradientStop Color="#77142D44" Offset="0.58" />
                                <GradientStop Color="#151A3550" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Canvas IsHitTestVisible="False" Opacity="0.82">
                        <Line X1="0" Y1="72" X2="1600" Y2="72" Stroke="#2B5574" StrokeThickness="1" />
                        <Line X1="0" Y1="184" X2="1600" Y2="184" Stroke="#254B69" StrokeThickness="1" />
                        <Line X1="0" Y1="286" X2="1600" Y2="286" Stroke="#254B69" StrokeThickness="1" />
                        <Line X1="560" Y1="0" X2="492" Y2="360" Stroke="#3E6F92" StrokeThickness="1" />
                        <Line X1="890" Y1="0" X2="828" Y2="360" Stroke="#315F80" StrokeThickness="1" />
                        <Ellipse Width="430" Height="430" Canvas.Left="-230" Canvas.Top="-245" Stroke="#4E8DB5" StrokeThickness="1" />
                        <Ellipse Width="620" Height="620" Canvas.Left="1180" Canvas.Top="-260" Stroke="#7DBDE5" StrokeThickness="1" Opacity="0.36" />
                    </Canvas>

                    <Grid Margin="38,20,34,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="522" />
                            <ColumnDefinition Width="334" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="10,5" CornerRadius="14" Background="#23395D75" BorderBrush="#557FB1D7" BorderThickness="1">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#91DAFF" Text="磁盘驾驶舱" />
                                </Border>
                                <TextBlock Margin="12,4,0,0" FontSize="11" Foreground="#8EAEC5" Text="C 盘监控 / 清理 / D 盘迁移" />
                            </StackPanel>

                            <TextBlock Margin="0,14,0,0" FontSize="33" FontWeight="Bold" Foreground="#F5FAFF" LineHeight="40" Text="释放 C 盘空间，&#x0a;迁移大文件到 D 盘" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0" Width="486" FontSize="15" Foreground="#BBD1E3" LineHeight="24" TextWrapping="Wrap" Text="先扫描系统盘占用，再预览可清理项和可迁移目录。复制校验后再切换，避免误删、误迁移。" />

                            <UniformGrid Margin="0,18,0,0" Columns="3" Width="488" HorizontalAlignment="Left">
                                <Border Margin="0,0,10,0" Padding="13,10" CornerRadius="16" Background="#A511283C" BorderBrush="#4A93C7EA" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="#89A9BE" Text="剩余空间" />
                                        <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#58C7FF" Text="{Binding Dashboard.FreeSpaceText}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0" Padding="13,10" CornerRadius="16" Background="#A511283C" BorderBrush="#3E789DBE" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="#89A9BE" Text="C 盘使用率" />
                                        <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#F4FAFF" Text="{Binding Dashboard.UsedPercentText}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="13,10" CornerRadius="16" Background="#96102F3F" BorderBrush="#4A69E6E6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="#89A9BE" Text="7 天变化" />
                                        <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#55E2E2" Text="{Binding Dashboard.GrowthText}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                <Button MinWidth="126" Content="立即扫描" Click="RefreshDashboard" />
                                <Button Margin="10,0,0,0" MinWidth="134" Style="{StaticResource SecondaryButtonStyle}" Content="扫描可清理项" Click="ScanCleanupCandidates" />
                                <Button Margin="10,0,0,0" MinWidth="122" Style="{StaticResource SecondaryButtonStyle}" Content="迁移到 D 盘" Click="GoMigrationCenter" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="318"
                                Height="222"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Background="#B70B2338"
                                BorderBrush="#6FAED8F2"
                                BorderThickness="1"
                                CornerRadius="28"
                                Padding="18"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.28" Color="#02101E" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="#75D9FF" FontWeight="SemiBold" Text="COCKPIT STATUS" />
                                        <TextBlock Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#F5FAFF" Text="C 盘空间监控" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,6" CornerRadius="16" Background="#183B5C" BorderBrush="#4E9FD1" BorderThickness="1">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#58C7FF" Text="{Binding Dashboard.UsedPercentText}" />
                                    </Border>
                                </Grid>

                                <ProgressBar Grid.Row="1" Margin="0,18,0,0" Height="9" Background="#263F56" Foreground="#39B7FF" Maximum="100" Value="{Binding Dashboard.UsedPercent, Mode=OneWay}" />

                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="#92AFC5" Text="可用空间" />
                                        <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#EAF7FF" Text="{Binding Dashboard.FreeSpaceText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#92AFC5" Text="趋势" />
                                        <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#54D6D6" Text="{Binding Dashboard.GrowthText}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="1" Margin="30,12,30,0" Grid.ColumnSpan="3" Background="#426B88" VerticalAlignment="Top" />
                                    <StackPanel HorizontalAlignment="Left">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#173A59" BorderBrush="#4BA7DA" BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#75D9FF" FontWeight="Bold" Text="1" />
                                        </Border>
                                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="#B7CDE0" Text="扫描" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#173A59" BorderBrush="#4BA7DA" BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#75D9FF" FontWeight="Bold" Text="2" />
                                        </Border>
                                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="#B7CDE0" Text="清理" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#123F45" BorderBrush="#54D6D6" BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#54D6D6" FontWeight="Bold" Text="3" />
                                        </Border>
                                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="#B7CDE0" Text="迁移" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,4" Opacity="0.88">
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#91BBD5" Text="清理前预览 · 迁移前校验" />
                            <Border Margin="0,8,0,0" Height="3" Width="190" CornerRadius="2" Background="#3D9FEAFF" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <TabControl Grid.Row="4" x:Name="MainTabs">
                <TabItem Header="首页">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.28*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.92*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="高占用来源" />
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="优先看真正吃空间的目录，再决定清理、归档或迁移。" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Dashboard.UsedSpaceSummary}" />
                                    </Grid>

                                    <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Dashboard.TopSources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowSurfaceStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.05*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Text="●" />
                                                                </Border>
                                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                                                                <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="12" Background="#EFF7FF">
                                                                    <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding Badge}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Margin="38,7,0,0" Style="{StaticResource PathTextStyle}" Text="{Binding PathHint}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                                            <Grid>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding SizeText}" />
                                                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SizePercentText}" />
                                                            </Grid>
                                                            <ProgressBar Margin="0,8,0,0" Maximum="100" Value="{Binding SizePercent, Mode=OneWay}" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding GrowthText}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource TextMutedBrush}" Text="›" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="建议下一步" />
                                        <TextBlock Margin="0,6,0,16" Style="{StaticResource CaptionTextStyle}" Text="优先处理最安全、收益最高的空间项，清理前可预览。" />
                                        <ItemsControl ItemsSource="{Binding Dashboard.Suggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RowSurfaceStyle}">
                                                        <StackPanel>
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Detail}" />
                                                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="{Binding PrimaryActionLabel}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,18,0,0" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="安全规则" />
                                        <TextBlock Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="01  扫描只读取大小，不修改文件" />
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="02  清理前列出候选文件" />
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="03  微信数据库默认保护" />
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="04  迁移先复制校验，再切换联接" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="0.95*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="清理过滤器" />
                                        <TextBlock Margin="0,6,0,14" Style="{StaticResource CaptionTextStyle}" Text="适合先处理临时文件、下载旧文件、桌面大文件。" />
                                        <Button HorizontalAlignment="Left" MinWidth="136" Content="扫描可清理项" Click="ScanCleanupCandidates" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="C → D 迁移轨道" />
                                        <TextBlock Margin="0,6,0,14" Style="{StaticResource CaptionTextStyle}" Text="微信 / 企业微信这类持续增长目录，优先迁移到 D 盘。" />
                                        <Grid Height="52">
                                            <Line X1="28" Y1="26" X2="320" Y2="26" Stroke="#D6E2EF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Line X1="28" Y1="26" X2="205" Y2="26" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Border Width="48" Height="48" CornerRadius="16" Background="#EEF6FF" BorderBrush="#CFE5FF" BorderThickness="1" HorizontalAlignment="Left"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="C:" /></Border>
                                            <Border Width="48" Height="48" CornerRadius="16" Background="#EAF9F9" BorderBrush="#CBEFEF" BorderThickness="1" HorizontalAlignment="Right"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentAltBrush}" Text="D:" /></Border>
                                        </Grid>
                                        <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="打开迁移中心" Click="GoMigrationCenter" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="空间分析">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="重点路径明细" />
                                    <TextBlock Margin="0,6,0,18" Style="{StaticResource CaptionTextStyle}" Text="真实目录路径、占用和最近增长集中在这里看。" />
                                    <ItemsControl ItemsSource="{Binding Dashboard.SourceDetails}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowSurfaceStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="1.7*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PathTextStyle}" Text="{Binding PathText}" />
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding SizeText}" />
                                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding GrowthText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="大文件" />
                                    <TextBlock Margin="0,6,0,18" Style="{StaticResource CaptionTextStyle}" Text="适合先归档、再迁移，避免直接删除误伤。" />
                                    <ItemsControl ItemsSource="{Binding Dashboard.LargeFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowSurfaceStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding FileName}" />
                                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource PathTextStyle}" Text="{Binding PathText}" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding ModifiedText}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding SizeText}" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding Category}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="迁移中心">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="微信 / 企业微信迁移中心" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="先复制，校验通过后再切换目录联接；受保护目录不会自动迁移。" />
                                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AccentAltBrush}" FontWeight="SemiBold" Text="{Binding Migration.SummaryText}" />
                                </StackPanel>

                                <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Migration.Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowSurfaceStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <Border Margin="10,0,0,0" Padding="9,3" CornerRadius="12" Background="#EEF6FF">
                                                                <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusText}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Reason}" />
                                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource PathTextStyle}" Text="{Binding SourcePath}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="目标路径" />
                                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource PathTextStyle}" Text="{Binding SuggestedTargetPath}" />
                                                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="{Binding SizeText}" />
                                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding OperationHint}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button MinWidth="112" Content="执行复制" Click="ExecuteMigration" IsEnabled="{Binding CanExecuteCopy}" ToolTip="{Binding OperationHint}" />
                                                        <Button Margin="0,8,0,0" MinWidth="112" Style="{StaticResource SecondaryButtonStyle}" Content="切换联接" Click="SwitchMigration" IsEnabled="{Binding CanSwitch}" ToolTip="{Binding OperationHint}" />
                                                        <Button Margin="0,8,0,0" MinWidth="112" Style="{StaticResource DangerButtonStyle}" Content="回滚" Click="RollbackMigration" IsEnabled="{Binding CanRollback}" ToolTip="{Binding OperationHint}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="清理中心">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="清理预案" />
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="先扫描、再勾选、最后确认删除；文件优先移动到回收站。" />
                                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AccentAltBrush}" FontWeight="SemiBold" Text="{Binding Cleanup.SummaryText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button MinWidth="122" Content="扫描文件" Click="ScanCleanupCandidates" />
                                            <Button Margin="10,0,0,0" MinWidth="88" Style="{StaticResource SecondaryButtonStyle}" Content="全选" Click="SelectAllCleanup" />
                                            <Button Margin="10,0,0,0" MinWidth="96" Style="{StaticResource GhostButtonStyle}" Content="取消全选" Click="UnselectAllCleanup" />
                                            <Button Margin="10,0,0,0" MinWidth="122" Style="{StaticResource DangerButtonStyle}" Content="删除选中" Click="ExecuteSelectedCleanup" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Cleanup.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowSurfaceStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Description}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" MinWidth="108" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding ActionLabel}" Click="RunCleanupAction" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="待处理文件" />
                                    <TextBlock Margin="0,6,0,18" Style="{StaticResource CaptionTextStyle}" Text="默认全选只是建议，删除前可以逐项取消。" />
                                    <ItemsControl ItemsSource="{Binding Cleanup.Candidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowSurfaceStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="1.7*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource PathTextStyle}" Text="{Binding FullPath}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Category}" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding AgeText}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding SizeText}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
